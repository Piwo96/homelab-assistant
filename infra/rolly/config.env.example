# ===== Rolly Deployment Config =====
# Deploy-specific settings only. All skill credentials (TELEGRAM_BOT_TOKEN,
# HOMEASSISTANT_*, PIHOLE_*, PROTECT_*, UNIFI_*, PROXMOX_*, LM_STUDIO_*,
# ADMIN_TELEGRAM_ID, GAMING_PC_*) live in the project's root .env, which
# deploy.sh sources automatically before this file.
#
# Copy this file to config.env and fill in the values below.
# config.env is gitignored.

# --- LXC placement ---
LXC_HOSTNAME=rolly
LXC_IP_CIDR=192.168.10.200/24
LXC_GATEWAY=192.168.10.1
LXC_BRIDGE=vmbr0
LXC_CORES=2
LXC_MEMORY_MB=1024
LXC_DISK_GB=10
LXC_STORAGE=local-lvm
LXC_TEMPLATE_PREFIX=debian-12-standard

# --- Public endpoint (Let's Encrypt + Telegram webhook) ---
DUCKDNS_HOST=sophia-und-philipp.duckdns.org
DUCKDNS_TOKEN=
PUBLIC_PORT=8443

# --- Bot internal port (Caddy reverse_proxy target) ---
PORT=8080
