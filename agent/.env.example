# =============================================================================
# Agent runtime config
# =============================================================================
# This file is documentation only. All values live in the REPO ROOT .env
# (../.env from this directory) — the agent loads it via:
#     bun --env-file=../.env src/main.ts
# (see package.json scripts).
#
# Keys already present in root .env (legacy from agent-old/, do NOT redefine):
#   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_ALLOWED_USERS,
#   ADMIN_TELEGRAM_ID, LM_STUDIO_URL, LM_STUDIO_MODEL, EMBEDDING_MODEL,
#   GAMING_PC_IP, GAMING_PC_MAC, ANTHROPIC_API_KEY, plus skill creds.
#
# Keys you must ADD to root .env for the new agent:
# =============================================================================

# Whisper model id in LM Studio (used by Plan 3 multimodal — unused in MVP,
# but env loader still requires the var to be set)
WHISPER_MODEL=whisper-large-v3-turbo

# Bearer token for the agent's /internal/notify endpoint (Plan 5).
# Generate one with: openssl rand -hex 32
INTERNAL_NOTIFY_TOKEN=replace-with-32-byte-hex-string

# HTTP port the agent listens on
PORT=8080

# Skill discovery + runtime data. Paths are resolved relative to repo root
# (NOT to the agent/ directory) by main.ts.
SKILLS_ROOT=.claude/skills
DATA_DIR=data
